<?xml version="1.0" encoding="utf-8" ?>
<!-- Minimal single-node Dita application package (infra verification + future hybrid retrieval). Unverified until deployed. -->
<services version="1.0">
  <container id="default" version="1.0">
    <document-api/>
    <search/>
    <nodes>
      <node hostalias="node1"/>
    </nodes>
  </container>
  <content id="dita" version="1.0">
    <redundancy>1</redundancy>
    <documents>
      <document type="message" mode="index"/>
      <document type="knowledge" mode="index"/>
    </documents>
    <nodes>
      <node hostalias="node1" distribution-key="0"/>
    </nodes>
    <!-- Laptop dev tuning: Vespa blocks feeding above its memory/disk limits; a 4 GB container and a shared Docker
         Desktop disk would otherwise trip them early. Not used outside local development. -->
    <tuning>
      <resource-limits>
        <memory>0.90</memory>
        <disk>0.90</disk>
      </resource-limits>
    </tuning>
  </content>
</services>
