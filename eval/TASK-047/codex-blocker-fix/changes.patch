+        int nonIdPayloads = owner.queryForObject("SELECT count(*) FROM outbox WHERE id > ? AND "
+                + "(payload - 'groupId' - 'knowledgeId') <> '{}'::jsonb", Integer.class, lastEvent);
+        if (!fanIn) addFalseRelation(g);
+        rejectAndRemoveC(g);
