/.avengers/
/.peter-parker/
/outputs/
/eval/**/sealed/

# Local shell environment and disposable databases (schema/migrations remain visible)
.envrc
.envrc.*
!.envrc.example
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

